DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
JWT_SECRET="ganti-dengan-secret-panjang-random-minimal-32-karakter"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV="production"
ALLOWED_ORIGINS="https://nama-app-anda.vercel.app"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12
ADMIN_SECRET_KEY="ganti-dengan-secret-admin-anda"
ADMIN_SECRET_PATH="/markas-besar-pancasila"

# Cloudinary Configuration (Optional - for Cloud Storage integration)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

