generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("STUDENT") // STUDENT, ADMIN, TUTOR
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isActive      Boolean   @default(true)
  tokenVersion  Int       @default(0)
  lastLoginAt   DateTime?
  loginStreak   Int       @default(0)
  lastStreakAt  DateTime?
  xp            Int       @default(0)
  level         Int       @default(1)
  points        Int       @default(0)
  loginAttempts Int       @default(0)
  lockUntil     DateTime?

  progress      UserProgress[]
  quizAttempts  QuizAttempt[]
  achievements  UserAchievement[]
  activityLogs  ActivityLog[]
  materials     Material[]
  quizzes       Quiz[]
  comments      Comment[]
  streakDays    DailyStreak[]
  feedbacks     Feedback[]

  @@map("users")
}

model Feedback {
  id        String   @id @default(uuid())
  content   String
  category  String   @default("GENERAL") // SUGGESTION, BUG, MESSAGE
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("feedbacks")
  @@index([userId])
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  icon      String?
  color     String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  materials Material[]
  quizzes   Quiz[]

  @@map("categories")
}

model Material {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  description String?
  coverImage  String?
  videoUrl    String?
  driveUrl    String?
  fileUrl     String?
  type        String   @default("ARTICLE") // ARTICLE, VIDEO, BOOK
  categoryId  String
  authorId    String
  difficulty  String   @default("EASY")    // EASY, MEDIUM, HARD
  targetRange String   @default("4-7")     // 4-7 (Kelas 7), 8, 9
  isPublished Boolean  @default(false)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category      @relation(fields: [categoryId], references: [id])
  author      User          @relation(fields: [authorId], references: [id])
  progress    UserProgress[]
  comments    Comment[]

  @@map("materials")
  @@index([categoryId])
  @@index([authorId])
}

model Quiz {
  id           String      @id @default(uuid())
  title        String
  slug         String      @unique
  description  String?
  categoryId   String
  authorId     String
  difficulty   String      @default("EASY")    // EASY, MEDIUM, HARD
  targetRange  String      @default("4-7")     // 4-7 (Kelas 7), 8, 9
  quizType     String      @default("MULTIPLE_CHOICE")
  timeLimit    Int?        @default(3600)
  shuffle      Boolean     @default(true)
  isPublished  Boolean     @default(false)
  passingScore Int         @default(70)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  category     Category     @relation(fields: [categoryId], references: [id])
  author       User         @relation(fields: [authorId], references: [id])
  questions    Question[]
  attempts     QuizAttempt[]

  @@map("quizzes")
  @@index([categoryId])
  @@index([authorId])
}

model Question {
  id            String   @id @default(uuid())
  quizId        String
  content       String
  hint          String?
  explanation   String?
  imageUrl      String?
  driveUrl      String?
  order         Int      @default(0)
  points        Int      @default(1)
  createdAt     DateTime @default(now())

  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options       QuestionOption[]
  answers       QuizAttemptAnswer[]

  @@map("questions")
  @@index([quizId])
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  content    String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
  @@index([questionId])
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  materialId  String
  isCompleted Boolean  @default(false)
  progress    Int      @default(0)
  lastReadAt  DateTime @default(now())
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@map("user_progress")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  score       Int
  totalScore  Int
  percentage  Float
  isPassed    Boolean
  timeSpent   Int?
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAttemptAnswer[]

  @@map("quiz_attempts")
  @@index([userId])
  @@index([quizId])
}

model QuizAttemptAnswer {
  id         String   @id @default(uuid())
  attemptId  String
  questionId String
  answer     String?
  isCorrect  Boolean
  points     Int

  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_attempt_answers")
}

model Achievement {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  icon        String
  points      Int      @default(0)
  criteria    String
  createdAt   DateTime @default(now())

  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model DailyStreak {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @default(now())
  minutes   Int      @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_streaks")
}

model Comment {
  id         String   @id @default(uuid())
  content    String
  userId     String
  materialId String?
  quizId     String?
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")

  @@map("comments")
  @@index([userId])
  @@index([materialId])
  @@index([parentId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  entityType  String?
  entityId    String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
  @@index([userId])
}

model QuestionBank {
  id          String   @id @default(uuid())
  question    String
  hint        String?
  explanation String?
  categoryId  String?
  difficulty  String   @default("EASY")
  quizType    String   @default("MULTIPLE_CHOICE")
  points      Int      @default(1)
  createdAt   DateTime @default(now())

  options     QuestionBankOption[]

  @@map("question_bank")
  @@index([categoryId])
}

model QuestionBankOption {
  id             String   @id @default(uuid())
  questionBankId String
  content        String
  isCorrect      Boolean  @default(false)
  order          Int      @default(0)

  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)

  @@map("question_bank_options")
  @@index([questionBankId])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("announcements")
}

model SystemConfig {
  id              String   @id @default(uuid())
  maintenanceMode Boolean  @default(false)
  lockdownMode    Boolean  @default(false)
  maintenanceMsg  String?  @default("Sistem sedang dalam pemeliharaan rutin. Harap kembali lagi nanti.")
  
  // Custom Theme Colors
  easyColor       String   @default("#10B981")
  mediumColor     String   @default("#F59E0B")
  hardColor       String   @default("#EF4444")

  broadcastActive Boolean  @default(false)
  broadcastTitle  String?
  broadcastMsg    String?
  broadcastPriority Int    @default(0) // 0: Normal, 1: Urgent, 2: Critical
  updatedAt       DateTime @updatedAt

  @@map("system_config")
}

model IpBlacklist {
  id        String   @id @default(uuid())
  ip        String   @unique
  reason    String?
  blockedBy String?
  createdAt DateTime @default(now())

  @@map("ip_blacklist")
}
