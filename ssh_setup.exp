set timeout -1

# Load sensitive variables from local environment to prevent leaks
if {[info exists env(VPS_IP)]} {
    set vps_ip $env(VPS_IP)
} else {
    puts "Error: VPS_IP environment variable is not set."
    exit 1
}

if {[info exists env(VPS_PASSWORD)]} {
    set vps_password $env(VPS_PASSWORD)
} else {
    puts "Error: VPS_PASSWORD environment variable is not set."
    exit 1
}

if {[info exists env(NEON_DATABASE_URL)]} {
    set database_url $env(NEON_DATABASE_URL)
} else {
    puts "Error: NEON_DATABASE_URL environment variable is not set."
    exit 1
}

# Spawn SSH connection
spawn ssh -o StrictHostKeyChecking=no ubuntu@$vps_ip
expect "password:"
send "$vps_password\r"
expect "$ "

send "echo '--- MEMULAI SETUP BACKEND ---'\r"
expect "$ "

send "curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -\r"
expect "$ "

send "sudo apt-get install -y nodejs git\r"
expect "$ "

send "sudo npm install -g pm2\r"
expect "$ "

send "cd ~\r"
expect "$ "

send "rm -rf pancasila\r"
expect "$ "

send "git clone https://github.com/BedulTuru/pancasila.git\r"
expect "$ "

send "cd pancasila/backend\r"
expect "$ "

send "cat << 'EOF' > .env\n"
send "DATABASE_URL=\"$database_url\"\n"
send "JWT_SECRET=\"pancasila-edu-secret-key-2024-minimum-32-chars\"\n"
send "JWT_EXPIRES_IN=\"7d\"\n"
send "PORT=4000\n"
send "NODE_ENV=\"development\"\n"
send "ALLOWED_ORIGINS=\"http://localhost:5173,http://localhost:3000,http://localhost:4173,https://pancasila.vercel.app\"\n"
send "RATE_LIMIT_WINDOW_MS=900000\n"
send "RATE_LIMIT_MAX_REQUESTS=100\n"
send "BCRYPT_ROUNDS=12\n"
send "ADMIN_SECRET_KEY=\"god-tier-pancasila-secret-2024-xyz\"\n"
send "ADMIN_SECRET_PATH=\"/markas-besar-pancasila\"\n"
send "SUPER_ADMIN_PIN=\"121120\"\n"
send "EOF\r"
expect "$ "

send "npm install\r"
expect "$ "

send "npm run build\r"
expect "$ "

send "pm2 delete pancasila-api 2>/dev/null || true\r"
expect "$ "

send "pm2 start dist/src/index.js --name \"pancasila-api\"\r"
expect "$ "

send "pm2 save\r"
expect "$ "

send "exit\r"
expect eof
